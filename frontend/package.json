{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 3000",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server.js",
    "docker-dev:up": "docker compose -f docker-compose-dev.yaml up",
    "docker-dev:down": "docker compose -f docker-compose-dev.yaml down --volumes",
    "docker-prod:up": "docker compose -f docker-compose-prod.yaml up --build -d",
    "docker-prod:down": "docker compose -f docker-compose-prod.yaml down"
  },
  "dependencies": {
    "express": "^5.2.1",
    "@stream-io/video-react-sdk": "^1.33.4",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.6",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-router": "^7.13.1",
    "stream-chat": "^9.35.1",
    "stream-chat-react": "^13.14.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "daisyui": "^5.5.19",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1"
  }
